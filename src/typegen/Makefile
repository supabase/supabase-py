help::
	@echo "Available commands"
	@echo "  help           -- (default) print this message"

tests: pyrefly pytest
help::
	@echo "  tests          -- run all tests for supabase_typegen package"

pytest:
	uv run --package supabase_typegen pytest --cov=./ --cov-report=xml -vv
help::
	@echo "  pytest         -- run pytest on supabase_typegen package"

pyrefly:
	uv run --package supabase_typegen pyrefly check
help::
	@echo "  pyrefly        -- run pyrefly on supabase_typegen"

goldens:
	UPDATE_GOLDENS=1 uv run --package supabase_typegen pytest tests/test_goldens.py
help::
	@echo "  goldens        -- regenerate the golden modules of the test fixtures"

clean:
	rm -rf htmlcov .pytest_cache .ruff_cache
	rm -f .coverage coverage.xml
help::
	@echo "  clean          -- clean intermediary files generated by tests"

build:
	uv build --package supabase_typegen
help::
	@echo "  build          -- invoke uv build on supabase_typegen package"
