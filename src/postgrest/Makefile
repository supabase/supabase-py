help::
	@echo "Available commands"
	@echo "  help           -- (default) print this message"

tests: pyrefly pytest
help::
	@echo "  tests          -- run all tests for postgrest package"

pytest: start-infra
	uv run --package postgrest pytest --cov=./ --cov-report=xml -vv
help::
	@echo "  pytest         -- run pytest on postgrest package"

pyrefly:
	uv run --package postgrest pyrefly check
help::
	@echo "  pyrefly        -- run pyrefly on postgrest"

include ../../infra.mk

POSTGREST_EXCLUDED_SERVICES := studio,gotrue,mailpit,realtime,storage-api,imgproxy,edge-runtime,logflare,vector,supavisor,postgres-meta

start-infra:
	@$(call retry_start_infra,$(call supabase_cleanup,postgrest-py-tests),supabase --workdir infra start -x $(POSTGREST_EXCLUDED_SERVICES))
help::
	@echo "  start-infra    -- start containers for tests"

stop-infra:
	supabase --workdir infra stop
help::
	@echo "  stop-infra     -- stop containers for tests"

clean:
	rm -rf htmlcov .pytest_cache .ruff_cache
	rm -f .coverage coverage.xml
help::
	@echo "  clean          -- clean intermediary files generated by tests"

build:
	uv build --package postgrest
help::
	@echo "  build          -- invoke uv build on postgrest package"
